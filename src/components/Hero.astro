---
import { useTranslations } from '@/i18n/ui'
import type { Lang } from '@/i18n/locales'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const bullets = [
  { label: t('hero.bullet1'), tint: 'bg-tint-rose' },
  { label: t('hero.bullet2'), tint: 'bg-tint-mint' },
  { label: t('hero.bullet3'), tint: 'bg-tint-lilac' }
]
---

<section class="relative overflow-hidden">
  <!-- Two offset pastel washes give the cream page some depth without a hard edge. -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="motion-hero-orb absolute -top-24 -left-24 h-80 w-80 rounded-full bg-tint-rose blur-3xl"
      style="--orb-opacity: 0.6"
    >
    </div>
    <div
      class="motion-hero-orb absolute -top-16 right-0 h-72 w-72 rounded-full bg-tint-sky blur-3xl"
      style="--motion-delay: 100ms; --orb-opacity: 0.5"
    >
    </div>
  </div>

  <div class="motion-hero-copy mx-auto w-full max-w-3xl px-4 pt-16 pb-10 text-center sm:pt-24">
    <p class="text-muted mb-5 text-sm font-semibold tracking-widest uppercase">
      {t('header.privacy')}
    </p>
    <h1 class="text-4xl leading-[1.05] font-semibold text-balance sm:text-6xl">
      {t('hero.title')}
    </h1>
    <p class="text-muted mx-auto mt-6 max-w-xl text-lg text-pretty">
      {t('hero.subtitle')}
    </p>
    <ul class="mt-8 flex flex-wrap justify-center gap-2">
      {
        bullets.map((bullet, index) => (
          <li
            class:list={[
              'motion-bullet rounded-full border border-base-300 px-4 py-1.5 text-sm font-medium',
              bullet.tint
            ]}
            style={`--motion-delay: ${180 + index * 55}ms`}
          >
            {bullet.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>
