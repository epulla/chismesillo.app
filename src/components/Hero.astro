---
import { useTranslations } from '@/i18n/ui'
import type { Lang } from '@/i18n/locales'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const bullets = [t('hero.bullet1'), t('hero.bullet2'), t('hero.bullet3')]
---

<section class="mx-auto w-full max-w-5xl px-4 pt-10 pb-6 text-center">
  <h1 class="text-3xl font-bold text-balance sm:text-4xl">{t('hero.title')}</h1>
  <p class="mx-auto mt-3 max-w-2xl text-base opacity-75 text-pretty">{t('hero.subtitle')}</p>
  <ul class="mt-5 flex flex-wrap justify-center gap-2">
    {
      bullets.map((bullet) => (
        <li class="badge badge-outline badge-lg gap-1 whitespace-nowrap">{bullet}</li>
      ))
    }
  </ul>
</section>
