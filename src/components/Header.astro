---
import { useTranslations } from '@/i18n/ui'
import { languages, type Lang } from '@/i18n/locales'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<header
  class="bg-base-200/85 sticky top-0 z-30 border-b border-base-300 backdrop-blur supports-[backdrop-filter]:bg-base-200/70"
>
  <div class="mx-auto flex w-full max-w-5xl items-center gap-3 px-4 py-3">
    <a
      href={lang === 'en' ? '/' : '/es/'}
      class="flex items-center gap-2 text-lg font-bold tracking-tight"
    >
      <span aria-hidden="true">🤫</span>
      chismesillo
    </a>
    <span class="text-muted hidden text-sm sm:inline">{t('header.tagline')}</span>

    <div class="ml-auto flex items-center gap-2">
      <span class="badge badge-primary badge-sm whitespace-nowrap">{t('header.privacy')}</span>
      <a
        href="https://github.com/epulla/chismesillo.app"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost btn-sm"
        aria-label={t('header.sourceCode')}
      >
        {
          /* GitHub mark from primer/octicons (MIT). The 16x16 viewBox is theirs; rescaling
            the path by hand would be a guess, so it travels with the icon. */
        }
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"
          ></path>
        </svg>
        <span class="hidden sm:inline">{t('header.sourceCode')}</span>
      </a>
      <nav aria-label={t('a11y.languageNav')}>
        <ul class="join">
          {
            Object.entries(languages).map(([code, label]) => (
              <li class="contents">
                <a
                  href={code === 'en' ? '/' : `/${code}/`}
                  class:list={['btn join-item btn-sm', code === lang ? 'btn-primary' : 'btn-ghost']}
                  hreflang={code}
                  aria-current={code === lang ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
