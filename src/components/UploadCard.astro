---
import { useTranslations } from '@/i18n/ui'
import type { Lang } from '@/i18n/locales'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section class="card bg-base-100 shadow-sm">
  <div class="card-body gap-4">
    <h2 class="card-title text-lg">{t('upload.title')}</h2>

    <label
      id="dropzone"
      for="file-input"
      class="dropzone flex cursor-pointer flex-col items-center gap-2 px-6 py-10 text-center"
    >
      <span class="text-4xl" aria-hidden="true">🎧</span>
      <span class="font-medium">{t('upload.hint')}</span>
      <span class="text-xs opacity-60">{t('upload.formats')}</span>
      <span class="btn btn-primary btn-sm mt-2">{t('upload.browse')}</span>
      <input id="file-input" type="file" accept="audio/*,video/*" class="hidden" />
    </label>

    <div id="file-summary" class="hidden flex-col gap-3">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-2xl" aria-hidden="true">📼</span>
        <div class="min-w-0 flex-1">
          <p id="file-name" class="truncate font-medium"></p>
          <p id="file-meta" class="text-xs opacity-60"></p>
        </div>
        <button id="file-change" type="button" class="btn btn-ghost btn-sm">
          {t('upload.change')}
        </button>
      </div>
      <audio id="player" controls class="w-full"></audio>
    </div>

    <div id="restore-banner" class="alert alert-info hidden">
      <span id="restore-text" class="text-sm"></span>
      <div class="flex gap-2">
        <button id="restore-accept" type="button" class="btn btn-sm"></button>
        <button id="restore-dismiss" type="button" class="btn btn-ghost btn-sm"></button>
      </div>
    </div>
  </div>
</section>
