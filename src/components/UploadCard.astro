---
import { useTranslations } from '@/i18n/ui'
import type { Lang } from '@/i18n/locales'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section class="motion-panel panel p-2">
  <!-- The input is sr-only, not `hidden`: display:none makes it unfocusable, which
       left the whole picker unreachable by keyboard. -->
  <input
    id="file-input"
    type="file"
    accept="audio/*,video/*"
    class="sr-only"
    aria-describedby="upload-formats"
  />

  <label
    id="dropzone"
    for="file-input"
    class="dropzone flex cursor-pointer flex-col items-center gap-3 px-6 py-14 text-center"
  >
    <span class="motion-upload-icon rounded-full bg-base-100 p-4 shadow-sm" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-primary"
      >
        <path d="M12 3v12"></path>
        <path d="m7 8 5-5 5 5"></path>
        <path d="M5 15v3a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-3"></path>
      </svg>
    </span>
    <span class="text-lg font-semibold">{t('upload.hint')}</span>
    <span id="upload-formats" class="text-muted max-w-md text-xs">{t('upload.formats')}</span>
    <span class="btn btn-primary btn-sm mt-2 rounded-full px-5" aria-hidden="true">
      {t('upload.browse')}
    </span>
  </label>

  <div id="file-summary" class="hidden flex-col gap-4 p-4">
    <div class="flex flex-wrap items-center gap-3">
      <span class="rounded-2xl bg-tint-mint p-3" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
      </span>
      <div class="min-w-0 flex-1">
        <p id="file-name" class="truncate font-semibold"></p>
        <p id="file-meta" class="text-muted text-xs"></p>
      </div>
      <button id="file-change" type="button" class="btn btn-ghost btn-sm rounded-full">
        {t('upload.change')}
      </button>
    </div>
    <audio id="player" controls class="w-full"></audio>
  </div>

  <div id="restore-banner" class="alert alert-soft alert-info mx-2 mb-2 hidden">
    <span id="restore-text" class="text-sm"></span>
    <div class="flex gap-2">
      <button id="restore-accept" type="button" class="btn btn-sm rounded-full"></button>
      <button id="restore-dismiss" type="button" class="btn btn-ghost btn-sm rounded-full"></button>
    </div>
  </div>
</section>
