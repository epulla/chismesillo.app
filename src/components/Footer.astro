---
import { useTranslations } from '@/i18n/ui'
import type { Lang } from '@/i18n/locales'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<footer class="mt-auto border-t border-base-300 bg-base-100">
  <div class="mx-auto grid w-full max-w-5xl gap-8 px-4 py-12 sm:grid-cols-[2fr_1fr]">
    <div>
      <h2 class="text-lg font-semibold">{t('footer.privacyTitle')}</h2>
      <p class="text-muted mt-3 max-w-prose text-sm leading-relaxed">{t('footer.privacyBody')}</p>
    </div>

    <div class="flex flex-col items-start gap-3">
      <div>
        <p class="text-sm font-semibold">{t('downloads.cacheTitle')}</p>
        <p id="cache-size" class="text-muted text-xs">{t('downloads.cacheEmpty')}</p>
      </div>
      <button id="clear-cache" type="button" class="btn btn-outline btn-sm rounded-full" disabled>
        {t('downloads.clear')}
      </button>
      <p class="text-muted mt-2 flex items-center gap-1.5 text-xs">
        <span>{t('footer.builtWith')}</span>
        <button
          id="dedication-trigger"
          type="button"
          class="easter-trigger"
          aria-label={t('footer.dedicationButton')}
        >
          <span aria-hidden="true">♡</span>
        </button>
      </p>
    </div>
  </div>

  <dialog id="dedication-dialog" class="modal" aria-label={t('footer.dedicationTitle')}>
    <div class="dedication-box modal-box text-center">
      <p class="easter-heart mx-auto mb-3 text-3xl" aria-hidden="true">♥</p>
      <h2 class="text-2xl font-semibold">{t('footer.dedicationTitle')}</h2>
      <p class="mt-4 text-pretty text-base leading-relaxed">{t('footer.dedication')}</p>
      <form method="dialog" class="modal-action justify-center">
        <button type="submit" class="btn btn-primary btn-sm rounded-full px-6">
          {t('footer.closeDedication')}
        </button>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button type="submit">{t('footer.closeDedication')}</button>
    </form>
  </dialog>
</footer>
