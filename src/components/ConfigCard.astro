---
import { useTranslations } from '@/i18n/ui'
import type { Lang } from '@/i18n/locales'
import { MODELS } from '@/scripts/models'
import { WHISPER_LANGUAGES } from '@/scripts/languages'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section id="config-card" class="card bg-base-100 hidden shadow-sm">
  <div class="card-body gap-4">
    <h2 class="card-title text-lg">{t('config.title')}</h2>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="form-control w-full">
        <div class="label"><span class="label-text font-medium">{t('config.model')}</span></div>
        <select id="model-select" class="select select-bordered w-full">
          {
            MODELS.map((model) => (
              <option value={model.id} data-requires-webgpu={String(model.requiresWebGPU)}>
                {t(`models.${model.key}`)}
              </option>
            ))
          }
        </select>
        <div class="label">
          <span id="model-help" class="label-text-alt opacity-70">{t('config.modelHelp')}</span>
        </div>
      </label>

      <label class="form-control w-full">
        <div class="label"><span class="label-text font-medium">{t('config.language')}</span></div>
        <select id="language-select" class="select select-bordered w-full">
          <option value="">{t('config.languageAuto')}</option>
          {
            WHISPER_LANGUAGES.map((language) => (
              <option value={language.code}>{language.name}</option>
            ))
          }
        </select>
      </label>

      <label class="form-control w-full">
        <div class="label"><span class="label-text font-medium">{t('config.task')}</span></div>
        <select id="task-select" class="select select-bordered w-full">
          <option value="transcribe">{t('config.taskTranscribe')}</option>
          <option value="translate">{t('config.taskTranslate')}</option>
        </select>
      </label>

      <label class="form-control w-full justify-end">
        <div class="label cursor-pointer justify-start gap-3">
          <input id="word-timestamps" type="checkbox" class="checkbox checkbox-primary" />
          <span class="label-text font-medium">{t('config.wordTimestamps')}</span>
        </div>
        <div class="label">
          <span class="label-text-alt opacity-70">{t('config.wordTimestampsHelp')}</span>
        </div>
      </label>
    </div>

    <div class="collapse-arrow collapse border border-base-300">
      <input type="checkbox" />
      <div class="collapse-title text-sm font-medium">{t('config.advanced')}</div>
      <div class="collapse-content grid gap-4 sm:grid-cols-2">
        <label class="form-control w-full">
          <div class="label">
            <span class="label-text">{t('config.windowMinutes')}</span>
            <span id="window-value" class="label-text-alt">10</span>
          </div>
          <input
            id="window-minutes"
            type="range"
            min="2"
            max="20"
            step="1"
            value="10"
            class="range range-primary range-sm"
          />
          <div class="label">
            <span class="label-text-alt opacity-70">{t('config.windowHelp')}</span>
          </div>
        </label>

        <label class="form-control w-full">
          <div class="label cursor-pointer justify-start gap-3">
            <input id="force-cpu" type="checkbox" class="checkbox checkbox-sm" />
            <span class="label-text">{t('config.forceCpu')}</span>
          </div>
          <div class="label">
            <span class="label-text-alt opacity-70">{t('config.forceCpuHelp')}</span>
          </div>
        </label>
      </div>
    </div>

    <div class="card-actions justify-end">
      <button id="cancel-button" type="button" class="btn btn-ghost hidden">
        {t('config.cancel')}
      </button>
      <button id="start-button" type="button" class="btn btn-primary">
        {t('config.start')}
      </button>
    </div>
  </div>
</section>
